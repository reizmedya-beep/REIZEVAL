# ==========================================
# REIZEVAL ENTERPRISE CONFIGURATION
# ==========================================

# Central PostgreSQL Connection (Prisma)
DATABASE_URL="postgresql://reiz_user:SuperSecretPassword123@postgres.internal.reizmedya.com:5432/reizeval_db?schema=public&sslmode=require"

# Central Fastify API (Client will connect to this)
NEXT_PUBLIC_CENTRAL_API_URL="https://api.reizeval.com"
PORT=4000
HOST="0.0.0.0"

# JWT & Authentication Secret Keys
JWT_SECRET="reiz_enterprise_super_secret_jwt_key_at_least_64_bytes_long_here"
REFRESH_TOKEN_SECRET="reiz_enterprise_refresh_token_secret_key_at_least_64_bytes"

# Cloudflare R2 / S3 Object Storage for Large ZIP/RAR Archives
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="reizeval-submissions"
R2_PUBLIC_DOMAIN="https://r2-storage.reizeval.com"

# Redis & BullMQ for Background Workers (ZIP Virus Scan & PDF Generation)
REDIS_URL="redis://:RedisSecurePassword@redis.internal.reizmedya.com:6379"

# Cryptographic Certificate Signing Key (Ed25519)
CERTIFICATE_PRIVATE_KEY_HEX="ed25519_private_key_hex_string_64_chars"
CERTIFICATE_PUBLIC_KEY_HEX="ed25519_public_key_hex_string_64_chars"

# Desktop Update & Google Drive Manifest
DESKTOP_CURRENT_VERSION="1.0.0"
DESKTOP_MIN_SUPPORTED_VERSION="1.0.0"
DESKTOP_GOOGLE_DRIVE_URL="https://drive.google.com/drive/folders/reizeval_official_dist"
